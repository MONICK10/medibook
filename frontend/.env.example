# MediBook frontend configuration
# ---------------------------------------------------------------
# Copy this file to frontend/.env if you need to change anything.
# Without a .env the defaults below are used, which is what you
# want when running everything locally.
#
# Vite only exposes variables that start with VITE_ to the browser.
# That is a safety feature, not a naming quirk: anything in here ends
# up in the JavaScript bundle that every visitor downloads, so NEVER
# put a secret, password or API key in this file.
# ---------------------------------------------------------------

# Where the backend API is.
# Change this to your load balancer or API domain when you deploy the
# built site to S3 and CloudFront.
VITE_API_URL=http://localhost:3000

# The clinic name shown in the header, the footer and the page title.
VITE_CLINIC_NAME=MediBook
