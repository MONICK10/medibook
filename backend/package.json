{
  "name": "medibook-backend",
  "version": "2.0.0",
  "private": true,
  "description": "MediBook backend - Express API with swappable local/AWS adapters",
  "main": "server.js",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "init-env": "node scripts/init-env.js",
    "seed": "node scripts/seed.js",
    "migrate": "node scripts/migrate.js",
    "check": "node scripts/check.js",
    "check:api": "node scripts/check-api.js",
    "test": "node scripts/check.js && node scripts/check-api.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2"
  }
}
