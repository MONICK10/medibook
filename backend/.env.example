# MediBook backend configuration
# ---------------------------------------------------------------
# Copy this file to backend/.env, or just run:  npm run init-env
# (which copies it AND fills in the two secrets with random values).
#
# backend/.env is in .gitignore and must never be committed.
# This example file must never contain a real secret.
# ---------------------------------------------------------------


# === Basics ====================================================

# development | production
# production turns on strict checks: the app refuses to start without
# real secrets, and logs less detail.
NODE_ENV=development

# Port the API listens on.
PORT=3000

# debug | info | warn | error
LOG_LEVEL=debug

# Where the browser reaches this API. Used to build file download links.
# Change this to your domain or load balancer address when you deploy.
API_PUBLIC_URL=http://localhost:3000

# Which websites may call this API (CORS). Comma-separated, no spaces.
# The Vite dev server is the default. Add your CloudFront URL later.
# Never use "*" here: it would let any site make requests as a
# logged-in user.
FRONTEND_URL=http://localhost:5173

# Set to true ONLY when the app really is behind a proxy that sets
# X-Forwarded-For (an AWS ALB, CloudFront, nginx). If you turn this on
# without such a proxy, a client can fake its IP address and dodge the
# rate limiter.
TRUST_PROXY=false


# === Adapter switches ==========================================
# These five lines decide whether the app runs entirely on your laptop
# or against AWS services. Everything else in the app is written so it
# does not know or care which is chosen.

# local | postgres
DB_MODE=local

# local | s3
STORAGE_MODE=local

# local | cognito
AUTH_MODE=local

# console | ses
MAIL_MODE=console

# env | aws
SECRETS_MODE=env


# === Secrets ===================================================
# "npm run init-env" fills these two in with random values.
# Leave them blank here. In production the app will not start without
# them.

# Signs the login tokens (JWTs). Changing it logs everyone out.
JWT_SECRET=

# Signs the short-lived file download links used in STORAGE_MODE=local.
FILE_SIGNING_SECRET=

# How long a login lasts. Short is safer: if a token is stolen, it
# stops working sooner. Examples: 30m, 2h, 7d
JWT_EXPIRES_IN=2h

# Written into each token and checked when it is verified.
JWT_ISSUER=medibook

# bcrypt work factor. Higher is slower to crack AND slower to log in.
# 10 is a sensible balance. Do not raise it much: bcryptjs is pure
# JavaScript, so it is already slower than the native version.
BCRYPT_ROUNDS=10

# How long a password reset link stays usable, in minutes.
PASSWORD_RESET_TTL_MINUTES=30


# === Files =====================================================

# Where local uploads and the local JSON database are kept.
# Both folders are in .gitignore.
UPLOAD_DIR=./uploads
DATA_DIR=./data

# Largest upload accepted, in bytes. 5242880 = 5 MB.
UPLOAD_MAX_BYTES=5242880

# How long a file download link works, in seconds. Kept short so a
# link that leaks (browser history, a chat message) is already dead.
FILE_URL_TTL_SECONDS=300


# === Booking rules =============================================

# How many days of slots a patient can see and book.
BOOKING_DAYS_AHEAD=7

# How close to the appointment a patient may still cancel or
# reschedule, in minutes. 120 = up to 2 hours before.
BOOKING_CANCEL_CUTOFF_MINUTES=120


# === Rate limits ===============================================
# Note: these counters live in one process's memory. Behind a load
# balancer with several instances, the effective limit is multiplied.
# Production needs a shared store (ElastiCache/Redis).

RATE_LIMIT_LOGIN_WINDOW_MINUTES=15
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_FORGOT_WINDOW_MINUTES=60
RATE_LIMIT_FORGOT_MAX=5
RATE_LIMIT_GLOBAL_WINDOW_MINUTES=15
RATE_LIMIT_GLOBAL_MAX=1000


# === Email =====================================================

# The From address on outgoing mail.
# With MAIL_MODE=console nothing is sent; the email is printed to this
# terminal instead, including password reset links.
MAIL_FROM=MediBook <no-reply@medibook.local>


# ===============================================================
# AWS SETTINGS - all ignored while the adapter switches above are
# set to their local values. Fill these in when you get to the AWS
# session.
#
# Note what is NOT here: AWS access keys. On EC2, ECS or Lambda the
# SDK picks up credentials from the attached IAM role automatically.
# Putting keys in a file is the thing you are learning not to do.
# ===============================================================

# --- DB_MODE=postgres (Amazon RDS) -----------------------------

# Either give one connection string...
DATABASE_URL=

# ...or these separate values.
PGHOST=localhost
PGPORT=5432
PGDATABASE=medibook
PGUSER=medibook

# The database password is NOT read from here directly. It is fetched
# through the secrets adapter, so that with SECRETS_MODE=aws it comes
# from Secrets Manager instead. This names the key to look up.
PGPASSWORD_SECRET_KEY=PGPASSWORD

# Only used when SECRETS_MODE=env: the actual password.
PGPASSWORD=

# RDS requires TLS. Set true in AWS.
PGSSL=false

# Maximum open connections in the pool. Keep it well under the RDS
# instance's limit, remembering every app instance has its own pool.
PGPOOL_MAX=10

# --- STORAGE_MODE=s3 -------------------------------------------

# The bucket must be private: no public access, no bucket policy
# granting anonymous reads. Downloads work through pre-signed URLs.
S3_BUCKET=
S3_REGION=
S3_KEY_PREFIX=reports/
S3_SIGNED_URL_TTL_SECONDS=300

# --- AUTH_MODE=cognito -----------------------------------------

COGNITO_REGION=
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# Maps Cognito group names to MediBook roles, as JSON. The defaults
# are admins -> admin, doctors -> doctor, patients -> patient; set
# this only if your groups are named differently.
COGNITO_GROUP_ROLE_MAP=

# --- MAIL_MODE=ses ---------------------------------------------

# The region your SES identity is verified in. Remember a new SES
# account is sandboxed: it can only send to verified addresses until
# you request production access.
SES_REGION=

# --- SECRETS_MODE=aws ------------------------------------------

# The name or ARN of one Secrets Manager secret holding a JSON object,
# e.g. {"PGPASSWORD":"...","JWT_SECRET":"..."}
AWS_SECRET_ID=
AWS_SECRET_REGION=
